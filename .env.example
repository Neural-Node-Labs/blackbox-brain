# Copy to .env at the project root and fill in real values.
# Never commit the real .env file.

POSTGRES_DB=gateway_db
POSTGRES_USER=gateway_user
POSTGRES_PASSWORD=change-me-to-a-strong-random-password

# Where Ollama is reachable from inside the gateway container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# Must match the origin the console is actually served from (browser
# Origin header), since the gateway validates this at startup and
# rejects '*'. With the default port mapping below this is correct as-is.
ALLOWED_ORIGINS=http://localhost:8088

# Must be >= 12 chars. The gateway refuses to start in production
# without this set.
SEED_ADMIN_PASSWORD=change-me-immediately-2026

ENVIRONMENT=production
TOKEN_TTL_MINUTES=60

# Host port the console (sci-fi terminal UI) is published on.
CONSOLE_PORT=8088

# SSH remote execution (optional — leave unset to disable SSH panel in the UI)
# Add credentials for each target defined in ssh/targets.json
# SSH_WEB01_PASSWORD=your-server-password
# SSH_DB01_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
# SSH_APP_CONTAINER_PASSWORD=container-password
SSH_COMMAND_TIMEOUT=60
SSH_MAX_OUTPUT_BYTES=51200
